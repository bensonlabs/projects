# Text files are stored and checked out with LF line endings on every machine
# (this matters on Windows, where git otherwise checks out CRLF).
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.wasm binary
*.ttf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
